{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "storm-studios",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  // El sitio vive solo en stormstudios.com.mx; sin copias en workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "www.stormstudios.com.mx", "custom_domain": true },
    { "pattern": "stormstudios.com.mx", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Conserva headers, redirects y rewrites de Next también para public/.
    // Cada petición pasa por el Worker y consume su cuota gratuita.
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
